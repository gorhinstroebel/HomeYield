{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeYield",
  "version": "1.0.1",
  "identifier": "com.homeyield.android13.preview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HomeYield",
        "width": 430,
        "height": 850,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../icon.svg"]
  }
}
