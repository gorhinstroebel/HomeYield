  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default HomeYield application permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/gorhinstroebel/HomeYield" },
        { "url": "https://github.com/gorhinstroebel/HomeYield/*" }
      ]
    }
  ]
}
